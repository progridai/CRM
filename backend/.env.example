# ============================================================
#  backend/.env.local — Configuracao local do CRM (PRIVADO)
# ============================================================
# Este arquivo NUNCA deve ser commitado no repositorio.
# Copie este template e preencha com os valores fornecidos
# pela equipe de infraestrutura.
#
# As chaves com __ sao mapeadas automaticamente para as
# configuracoes aninhadas do .NET (Configuration API).
#
# Exemplo de connection string:
#   Host=<host>;Port=5432;Database=<db>;Username=<user>;Password=<senha>
# ============================================================

ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Host=<host>;Port=5432;Database=<database>;Username=<user>;Password=<senha>